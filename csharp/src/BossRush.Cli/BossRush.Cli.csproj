<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BossRush.Cli</RootNamespace>
    <AssemblyName>bossrush</AssemblyName>
    <!--
      Single-file self-contained publish is the default distribution mode.
      We don't enable it in the csproj so the dev cycle (dotnet run) is fast.
      To ship: dotnet publish -c Release -r win-x64 \
                 /p:PublishSingleFile=true /p:SelfContained=true /p:EnableCompressionInSingleFile=true
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BossRush.Core\BossRush.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Oodle (oo2core_6_win64.dll) ships with Elden Ring and is required to
      decompress DCX_KRAK regulation.bin / EMEVD. Drop the DLL at csharp/oo2core_6_win64.dll
      (gitignored). The GUI and tests already copy it; the CLI needs the same
      so `bossrush run` can patch the mod.
    -->
    <None Include="..\..\oo2core_6_win64.dll"
          Condition="Exists('..\..\oo2core_6_win64.dll')">
      <Link>oo2core_6_win64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
